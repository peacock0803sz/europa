---
source: crates/europa-render/tests/render_snapshots.rs
expression: "common :: draw_lines(& lines, & options)"
---
{"width":40,"max_output_lines":200,"background":"dark"}
Buffer {
    area: Rect { x: 0, y: 0, width: 40, height: 3 },
    content: [
        "red = "␛[31mred"                        ",
        "nul = "␀"  # ␡ del                      ",
        "c1 = "␦"                                ",
    ],
    styles: [
        x: 0, y: 0, fg: Reset, bg: Reset, modifier: NONE,
        x: 6, y: 0, fg: Indexed(2), bg: Reset, modifier: NONE,
        x: 7, y: 0, fg: Indexed(1), bg: Reset, modifier: BOLD,
        x: 8, y: 0, fg: Indexed(2), bg: Reset, modifier: NONE,
        x: 16, y: 0, fg: Reset, bg: Reset, modifier: NONE,
        x: 6, y: 1, fg: Indexed(2), bg: Reset, modifier: NONE,
        x: 7, y: 1, fg: Indexed(1), bg: Reset, modifier: BOLD,
        x: 8, y: 1, fg: Indexed(2), bg: Reset, modifier: NONE,
        x: 9, y: 1, fg: Reset, bg: Reset, modifier: NONE,
        x: 11, y: 1, fg: Reset, bg: Reset, modifier: DIM,
        x: 13, y: 1, fg: Indexed(1), bg: Reset, modifier: BOLD,
        x: 14, y: 1, fg: Reset, bg: Reset, modifier: DIM,
        x: 18, y: 1, fg: Reset, bg: Reset, modifier: NONE,
        x: 5, y: 2, fg: Indexed(2), bg: Reset, modifier: NONE,
        x: 6, y: 2, fg: Indexed(1), bg: Reset, modifier: BOLD,
        x: 7, y: 2, fg: Indexed(2), bg: Reset, modifier: NONE,
        x: 8, y: 2, fg: Reset, bg: Reset, modifier: NONE,
    ]
}
