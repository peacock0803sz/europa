{"width":40,"max_output_lines":200,"background":"dark"}
Buffer {
    area: Rect { x: 0, y: 0, width: 40, height: 2 },
    content: [
        "%%timeit -n 10                          ",
        "sorted(range(100))                      ",
    ],
    styles: [
        x: 0, y: 0, fg: Indexed(6), bg: Reset, modifier: BOLD,
        x: 14, y: 0, fg: Reset, bg: Reset, modifier: NONE,
        x: 0, y: 1, fg: Indexed(4), bg: Reset, modifier: NONE,
        x: 6, y: 1, fg: Reset, bg: Reset, modifier: NONE,
        x: 7, y: 1, fg: Indexed(4), bg: Reset, modifier: NONE,
        x: 12, y: 1, fg: Reset, bg: Reset, modifier: NONE,
        x: 13, y: 1, fg: Indexed(6), bg: Reset, modifier: NONE,
        x: 16, y: 1, fg: Reset, bg: Reset, modifier: NONE,
    ]
}
