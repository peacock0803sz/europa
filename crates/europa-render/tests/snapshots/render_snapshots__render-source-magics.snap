{"width":40,"max_output_lines":200,"background":"dark"}
Buffer {
    area: Rect { x: 0, y: 0, width: 40, height: 14 },
    content: [
        "%timeit sum(range(10))                  ",
        "!pip list                               ",
        "if ready:                               ",
